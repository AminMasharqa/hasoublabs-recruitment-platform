# Backend_Api base URL used by the Api_Client.
# Optional: when unset the Web_Client falls back to /api/v1 (Requirement 1 AC10).
VITE_API_BASE_URL=/api/v1

# Contract_Generator (`npm run gen:api` / `npm run verify:api`) — build-time only,
# read from the process environment rather than bundled into the app.
# The OpenAPI document path is fixed at /api/openapi.json (Requirement 2 AC1);
# these variables only choose where it is retrieved from.
#
# Origin of the Backend_Api serving the reference document.
# Optional: defaults to http://127.0.0.1:8000.
# BACKEND_ORIGIN=http://127.0.0.1:8000
#
# Full document URL. Takes precedence over BACKEND_ORIGIN when set — use it to
# point the drift check at a published reference document in CI.
# OPENAPI_URL=http://127.0.0.1:8000/api/openapi.json
