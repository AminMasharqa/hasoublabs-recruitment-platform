# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-min-32-chars
APP_DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hasoub:hasoub@localhost:5432/hasoub_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Valkey / Redis ────────────────────────────────────────────────────────────
VALKEY_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_CV_BUCKET=cvs
MINIO_CV_QUARANTINE_BUCKET=cvs-quarantine

# ── OpenBao (Key Management) ──────────────────────────────────────────────────
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=dev-root-token
OPENBAO_TRANSIT_KEY=hasoub-data-key

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@hasoublabs.com
SMTP_FROM_NAME=HasoubLabs

# ── Security ──────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=1800
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
MFA_ISSUER=HasoubLabs
DENY_FLOOR_MS=120
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128

# ── ClamAV ────────────────────────────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hasoublabs-recruitment-platform
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_CV_UPLOADS_PER_HOUR=10
RATE_LIMIT_APPLICATIONS_PER_24H=20

# ── Registration ──────────────────────────────────────────────────────────────
REGISTRATION_LINK_TTL_SECONDS=86400
VERIFICATION_CODE_TTL_HOURS=72
VERIFICATION_CODE_MAX_ATTEMPTS=5
