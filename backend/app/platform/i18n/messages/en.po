#	HasoubLabs Recruitment Platform — English message catalog.
#	Message ids are stable machine keys, never prose. Keep the three catalogs
#	(en/ar/he) in key-for-key sync; a missing key falls back to English and then
#	to the key itself.
msgid ""
msgstr ""
"Project-Id-Version: hasoublabs-recruitment-platform 0.1.0\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

# ── API errors (one per error class in the design's error table) ──────────────

msgid "error.validation_failed"
msgstr "Some of the submitted fields are not valid."

msgid "error.authentication_required"
msgstr "Please sign in to continue."

msgid "error.not_authorized"
msgstr "You are not authorized to perform this action."

msgid "error.account_not_approved"
msgstr "Your account is not approved yet."

msgid "error.illegal_transition"
msgstr "That change is not allowed from the current state."

msgid "error.conflicting_state"
msgstr "This conflicts with data that already exists."

msgid "error.precondition_unmet"
msgstr "Some requirements for this action are not met yet."

msgid "error.rate_limited"
msgstr "Too many requests. Please try again shortly."

msgid "error.code_entry_locked"
msgstr "Code entry is locked. Request a new verification code to continue."

msgid "error.integrity_violation"
msgstr "An integrity check failed. An administrator has been alerted."

msgid "error.upstream_unavailable"
msgstr "A required service is temporarily unavailable. Please try again."

msgid "error.internal_server_error"
msgstr "Something went wrong. Please try again."

msgid "error.bad_request"
msgstr "The request could not be understood."

msgid "error.not_found"
msgstr "That resource does not exist."

msgid "error.method_not_allowed"
msgstr "That method is not allowed for this resource."

msgid "error.unsupported_media_type"
msgstr "That content type is not supported."

msgid "error.http_error"
msgstr "The request could not be completed."

# ── Domain errors (one per error class in the modules' errors.py) ─────────────

msgid "error.application_not_ready"
msgstr "Your profile is not ready for applications yet. Complete the missing items and try again."

msgid "error.audit_write_failed"
msgstr "The action could not be recorded, so it was not completed. Please try again."

msgid "error.contact_preference_invalid"
msgstr "The selected contact preferences do not fit together. Review them and try again."

msgid "error.cv_integrity_error"
msgstr "This CV file failed an integrity check and cannot be provided."

msgid "error.cv_limit_exceeded"
msgstr "You have reached the maximum number of active CV variants. Archive one before creating another."

msgid "error.cv_upload_validation_failed"
msgstr "This file cannot be uploaded. Choose a PDF or Word document within the size limit."

msgid "error.duplicate_application"
msgstr "You have already applied to this role."

msgid "error.duplicate_email"
msgstr "An account with this email address already exists for this account type."

msgid "error.export_failed"
msgstr "The export could not be generated. Please try again."

msgid "error.export_not_ready"
msgstr "The export is still being prepared. Please check again shortly."

msgid "error.extraction_draft_expired"
msgstr "This draft has expired. Start the job description extraction again."

msgid "error.invalid_mfa_code"
msgstr "The authentication code is incorrect. Please try again."

msgid "error.invalid_registration_link"
msgstr "This registration link is invalid or has expired. Ask for a new one."

msgid "error.invalid_verification_code"
msgstr "The verification code is incorrect."

msgid "error.jd_already_closed"
msgstr "This job description is already closed."

msgid "error.jd_edit_forbidden_when_closed"
msgstr "A closed job description cannot be edited."

msgid "error.jd_not_open"
msgstr "This role is not open for applications."

msgid "error.jd_publish_precondition_failed"
msgstr "This job description cannot be published yet. Complete the required details first."

msgid "error.last_variant_error"
msgstr "You cannot archive your only active CV variant."

msgid "error.mfa_required"
msgstr "Enter the code from your authenticator app to continue."

msgid "error.profile_validation_failed"
msgstr "Some profile fields are not valid. Correct them and try again."

msgid "error.residency_validation_failed"
msgstr "The residency proof could not be validated. Check the details and try again."

msgid "error.review_correction_not_allowed"
msgstr "You can only correct your own review of this candidate."

msgid "error.skill_limit_exceeded"
msgstr "A profile can list at most 20 skills."

msgid "error.ssrf_guard_rejected"
msgstr "This web address cannot be used. Enter the public address of a job posting."

msgid "error.unsupported_entity_type"
msgstr "This type of data cannot be exported."

msgid "error.verification_code_expired"
msgstr "This verification code has expired. Request a new code."

# ── Field-level error codes ──────────────────────────────────────────────────

msgid "error.field.invalid"
msgstr "This value is not valid."

msgid "error.field.required"
msgstr "This field is required."

msgid "error.field.blank"
msgstr "This field cannot be blank."

msgid "error.field.too_long"
msgstr "This value is too long."

msgid "error.field.too_short"
msgstr "This value is too short."

msgid "error.field.invalid_email"
msgstr "Enter a valid email address."

msgid "error.field.invalid_e164"
msgstr "Enter a valid phone number in international format."

msgid "error.field.invalid_url"
msgstr "Enter a valid HTTPS URL."

msgid "error.field.invalid_enum"
msgstr "Choose one of the allowed values."

msgid "error.field.invalid_type"
msgstr "This value has the wrong type."

msgid "error.field.end_before_start"
msgstr "The end date cannot be earlier than the start date."

msgid "error.field.out_of_range"
msgstr "This value is outside the allowed range."

msgid "error.field.invalid_cursor"
msgstr "That page cursor is not valid. Start from the first page."

msgid "error.field.mutually_exclusive"
msgstr "These parameters cannot be used together."

# ── Transactional emails (Phase 1 Notifications) ─────────────────────────────

msgid "email.verification_code.subject"
msgstr "Your HasoubLabs verification code"

msgid "email.verification_code.body"
msgstr ""
"Hello {full_name},\n"
"\n"
"Your verification code is: {code}\n"
"\n"
"The code expires in {expiry_hours} hours. If you did not request it, you can "
"ignore this message."

msgid "email.registration_awaiting_review.subject"
msgstr "A new registration is awaiting review"

msgid "email.registration_awaiting_review.body"
msgstr ""
"{full_name} confirmed their email address and is waiting for review as "
"{role}.\n"
"\n"
"Open the admin dashboard to review the registration."

msgid "email.onboarding_meeting_required.subject"
msgstr "Arrange an onboarding meeting"

msgid "email.onboarding_meeting_required.body"
msgstr ""
"{full_name} has been approved and is waiting for an onboarding meeting.\n"
"\n"
"Open the admin dashboard to arrange it."

msgid "email.account_approved.subject"
msgstr "Your HasoubLabs account is approved"

msgid "email.account_approved.body"
msgstr ""
"Hello {full_name},\n"
"\n"
"Your account is now approved and you have full access to the platform."

msgid "email.account_rejected.subject"
msgstr "An update about your HasoubLabs registration"

msgid "email.account_rejected.body"
msgstr ""
"Hello {full_name},\n"
"\n"
"Your registration was not approved.\n"
"\n"
"Reason: {reason}"

msgid "email.application_submitted.subject"
msgstr "We received your application"

msgid "email.application_submitted.body"
msgstr ""
"Hello {full_name},\n"
"\n"
"Your application for {job_title} at {company} was submitted successfully."

msgid "email.application_status_changed.subject"
msgstr "Your application status changed"

msgid "email.application_status_changed.body"
msgstr ""
"Hello {full_name},\n"
"\n"
"Your application for {job_title} is now: {status}"

msgid "email.cv_quarantined.subject"
msgstr "Your CV upload could not be made available"

msgid "email.cv_quarantined.body"
msgstr ""
"Hello {full_name},\n"
"\n"
"The security scan flagged the file {file_name}, so it was quarantined and is "
"not available for applications. Please upload a different file."

msgid "email.cv_integrity_failed.subject"
msgstr "A CV integrity check failed"

msgid "email.cv_integrity_failed.body"
msgstr ""
"Hello {full_name},\n"
"\n"
"An integrity check failed for the file {file_name}. Our team has been "
"notified and will follow up."

msgid "email.signature"
msgstr "HasoubLabs Recruitment Team"

# ── In-app notification titles ───────────────────────────────────────────────

msgid "notification.verification_code_issued.title"
msgstr "Verification code sent"

msgid "notification.registration_awaiting_review.title"
msgstr "New registration awaiting review"

msgid "notification.onboarding_meeting_required.title"
msgstr "Onboarding meeting needed"

msgid "notification.account_decision_recorded.title"
msgstr "Your account status changed"

msgid "notification.application_submitted.title"
msgstr "Application submitted"

msgid "notification.application_status_changed.title"
msgstr "Application status changed"

msgid "notification.cv_integrity_issue.title"
msgstr "There is a problem with a CV file"
