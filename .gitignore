# ---------------------------------------------------------------------------
# HasoubLabs Recruitment Platform
# Python 3.12 / FastAPI modular monolith + React 18 / TypeScript / Vite SPA
# See .kiro/specs/hasoublab-recruitment-platform/design.md for the full stack
# ---------------------------------------------------------------------------

# === Secrets and credentials =============================================
# Never commit these. OpenBao holds the real keys; these files are local only.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/
openbao/data/
openbao-token
vault-token
.vault-token

# === Python ==============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments (uv manages deps; the venv itself is never committed)
.venv/
venv/
env/
ENV/
.python-version

# uv keeps uv.lock TRACKED on purpose: CI installs from the lockfile only
# (do not add uv.lock here)

# === Testing, coverage, property-based testing ===========================
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
junit*.xml
.tox/
.nox/

# Hypothesis: the example DB is machine-local. Keep the shrunk-failure
# corpus out of git; the nightly deep run regenerates it.
.hypothesis/

# Schemathesis / Locust artifacts
.schemathesis/
locust-report*.html
locust_stats*.csv

# === Type checking, linting, security scanning ===========================
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/
bandit-report.json
semgrep-results.json
trivy-results*.json
pip-audit-report.json

# === Alembic =============================================================
# Migration scripts ARE tracked (state reconstruction depends on a known
# column history, R8 AC6). Only local overrides are ignored.
alembic.local.ini

# === Local service data volumes (Docker Compose dev stack) ===============
# PostgreSQL, Valkey, MinIO, ClamAV, Mailpit bind mounts
.data/
pgdata/
postgres-data/
valkey-data/
redis-data/
minio-data/
clamav-data/
mailpit-data/

# === Application runtime artifacts =======================================
# CV uploads live in MinIO, never in the repo. These are local scratch dirs.
uploads/
quarantine/
tmp/
temp/
*.log
logs/

# Server-side Excel exports (R29) are generated on demand
exports/
*.xlsx
!docs/**/*.xlsx

# Bundled reference data is TRACKED (israeli_localities, mobile prefixes).
# Only locally regenerated caches are ignored.
.cache/localities/

# === Frontend (React 18 + TypeScript + Vite) =============================
node_modules/
frontend/node_modules/
.pnp
.pnp.js
frontend/dist/
frontend/build/
frontend/.vite/
frontend/stats.html
.eslintcache
.stylelintcache
*.tsbuildinfo

# Generated API client and Zod schemas (derived from the FastAPI OpenAPI
