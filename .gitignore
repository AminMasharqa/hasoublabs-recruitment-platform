npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.yarn/cache/
.yarn/install-state.gz

# === i18n ================================================================
# Babel .po source catalogs are tracked; compiled .mo files are build output
*.mo

# === Docker ==============================================================
# docker-compose.yml is tracked; local overrides are not
docker-compose.override.yml
docker-compose.*.local.yml
.dockerignore.local

